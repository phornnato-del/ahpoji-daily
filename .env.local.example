# Copy this file to .env.local and fill in your real MySQL credentials.
# Matches the "my_schedule" database from your Navicat dump.

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=my_schedule

# The user row your instance of AHPOJI DAILY acts as (see the `users` table).
# The dump you gave me has ID = 1 (username "ahpoji"), so 1 is the default.
APP_USER_ID=1
